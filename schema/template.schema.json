{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marketplace.miabi.io/schema/template.schema.json",
  "title": "Miabi Template (miabi.io/v1)",
  "description": "Declarative install manifest for a Miabi marketplace template (one document per version).",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata"],
  "properties": {
    "apiVersion": { "const": "miabi.io/v1" },
    "kind": { "const": "Template" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "displayName", "version"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "displayName": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "icon": { "type": "string" },
        "homepage": { "type": "string" },
        "minMiabi": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "author": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "email": { "type": "string", "format": "email" },
            "website": { "type": "string", "pattern": "^https?://" }
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "help": { "type": "string" },
          "type": { "enum": ["string", "password", "bool", "select", "number"] },
          "default": { "type": "string" },
          "placeholder": { "type": "string" },
          "pattern": { "type": "string" },
          "options": { "type": "array", "items": { "type": "string" } },
          "required": { "type": "boolean" },
          "generate": { "type": "boolean" },
          "length": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "databases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "engine"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "engine": { "enum": ["postgres", "mysql", "mariadb", "redis", "mongodb", "libsql"] },
          "version": { "type": "string" },
          "placement": { "enum": ["auto", "dedicated", "shared"] }
        }
      }
    },
    "volumes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 } }
      }
    },
    "configs": {
      "type": "array",
      "description": "Configuration files created before the applications are deployed and mounted into them read-only. File contents are interpolated exactly like env, so a config can carry a rendered database password.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "files"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "files": {
            "type": "object",
            "description": "File key -> content. The key is a relative path; 256 KB per file, 512 KB per config.",
            "minProperties": 1,
            "propertyNames": { "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*)?(/[A-Za-z0-9._-]+)*$" },
            "additionalProperties": { "type": "string", "maxLength": 262144 }
          },
          "mode": { "type": "string", "pattern": "^0?[0-7]{3}$", "description": "Default octal file mode for every file (0644 when omitted)." },
          "sensitive": { "type": "boolean", "description": "Content carries credentials: redacted in API responses and diffed by digest only." },
          "delimiters": {
            "type": "array",
            "description": "Interpolate on these markers instead of {{ }}, for files whose own syntax uses braces. Exactly two distinct entries.",
            "items": { "type": "string", "minLength": 1 },
            "minItems": 2,
            "maxItems": 2
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "description": "Configures the Stack the template's applications are grouped into. Present even for a single application forces a stack. Env declared here is shared across every member application (an app-level var with the same key wins).",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "secretEnv": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "image"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "primary": { "type": "boolean" },
          "image": { "type": "string", "minLength": 1 },
          "tag": { "type": "string" },
          "command": { "type": "array", "items": { "type": "string" } },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["container"],
              "properties": {
                "container": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "scheme": { "enum": ["http", "https"] }
              }
            }
          },
          "env": { "type": "object", "additionalProperties": { "type": "string" } },
          "secretEnv": { "type": "array", "items": { "type": "string" } },
          "mounts": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "description": "Mounts exactly one declared volume or config. With a config, omitting `key` projects every file under `path`; setting it pins one file to that exact path.",
              "oneOf": [
                { "required": ["volume"], "not": { "required": ["config"] } },
                { "required": ["config"], "not": { "required": ["volume"] } }
              ],
              "dependencies": { "key": ["config"], "mode": ["config"] },
              "properties": {
                "volume": { "type": "string" },
                "config": { "type": "string" },
                "key": { "type": "string", "pattern": "^[A-Za-z0-9]([A-Za-z0-9._-]*)?(/[A-Za-z0-9._-]+)*$" },
                "path": { "type": "string", "pattern": "^/" },
                "mode": { "type": "string", "pattern": "^0?[0-7]{3}$" },
                "readOnly": { "type": "boolean" }
              }
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "memory": { "type": "string" },
              "cpu": { "type": "string" }
            }
          },
          "healthcheck": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "type": { "enum": ["none", "http", "command"] },
              "path": { "type": "string" },
              "command": { "type": "string" },
              "port": { "type": "integer" },
              "intervalSeconds": { "type": "integer" },
              "timeoutSeconds": { "type": "integer" },
              "retries": { "type": "integer" },
              "startPeriodSeconds": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
